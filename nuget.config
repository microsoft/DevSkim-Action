<?xml version="1.0" encoding="utf-8"?>
<!--
  Explicit, trusted NuGet source configuration used when installing the
  DevSkim CLI, both at container build time (the pinned default version) and
  at container run time (an optional user-supplied version override).

  Using a single explicit source baked into the image ensures the package is
  always resolved from the official nuget.org feed rather than any feed that
  could be configured in a consuming repository's workspace.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
